# ===== App =====
NODE_ENV=development
PORT=4000
# Host bind HTTP server. Default: production=127.0.0.1 (di belakang nginx —
# jangan ekspos :4000 langsung), selain itu 0.0.0.0. Isi hanya bila perlu
# override (mis. container production butuh 0.0.0.0).
BIND_HOST=
APP_URL=http://localhost:3000
# WAJIB diganti string acak >= 32 char — generate: openssl rand -hex 32.
# NODE_ENV=production MENOLAK boot dengan nilai placeholder/default/pendek.
JWT_SECRET=ganti-dengan-string-acak-panjang
DATABASE_URL=postgres://adpulse:adpulse@localhost:5432/adpulse

# ===== AI (Claude) =====
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# ===== Mock mode (true = pakai data sample, tanpa API key ads asli) =====
MOCK_ADS=true

# ===== Google Ads =====
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ===== Meta Ads =====
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ===== LinkedIn Ads (phase 2) =====
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ===== Email =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=insights@adpulse.local

# ===== Scheduler (cron) =====
SYNC_CRON=0 */4 * * *
INSIGHT_EMAIL_CRON=0 12 * * *
# true = matikan semua cron (sync & email) — berguna saat dev/debug
DISABLE_CRON=false

# ===== Security & Hardening (v1.1) =====
JWT_ACCESS_TTL=1h
REFRESH_TOKEN_TTL_DAYS=30
# WAJIB di production — 64 hex char, generate: openssl rand -hex 32 (AES-256-GCM utk token ads di DB)
TOKEN_ENCRYPTION_KEY=
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=300
LOG_LEVEL=info
SENTRY_DSN=
DATABASE_URL_TEST=postgres://adpulse:adpulse@localhost:5432/adpulse_test

# ===== Agent AI + MCP (v1.2) =====
# Engine LLM untuk chat agent adalah SLOT, bukan vendor tetap.
#   auto      = pakai AGENT_ENGINE_* bila terisi lengkap, kalau tidak pakai ANTHROPIC_API_KEY
#   anthropic = paksa Anthropic (ANTHROPIC_API_KEY + CLAUDE_MODEL di atas)
#   openai    = paksa endpoint OpenAI-compatible (AGENT_ENGINE_* di bawah)
AGENT_PROVIDER=auto

# Slot endpoint OpenAI-compatible — OpenRouter, Groq, Together, vLLM lokal, dst.
# Contoh OpenRouter:
#   AGENT_ENGINE_URL=https://openrouter.ai/api/v1
#   AGENT_ENGINE_KEY=sk-or-v1-...
#   AGENT_ENGINE_MODEL=anthropic/claude-sonnet-4.5
AGENT_ENGINE_URL=
AGENT_ENGINE_KEY=
AGENT_ENGINE_MODEL=

# Batas satu giliran percakapan. maxToolChars menahan biaya tetap linear:
# hasil tool dikirim ulang ke model di tiap iterasi berikutnya.
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOKENS=2000
AGENT_TIMEOUT_MS=90000
AGENT_MAX_TOOL_CHARS=4000
AGENT_MAX_TOOL_CHARS_TOTAL=24000
AGENT_HISTORY_LIMIT=20

# Armada MCP eksternal. Daftar servernya di backend/mcp.json (slot WhatsApp &
# scraper ada di sana, defaultnya disabled). MCP_DISABLED=true mematikan
# seluruh armada — agent tetap jalan dengan tool AdPulse saja.
MCP_DISABLED=false
MCP_CONNECT_TIMEOUT_MS=8000
MCP_TOOL_TIMEOUT_MS=15000
# MCP_CONFIG_PATH=/path/lain/ke/mcp.json

# Token untuk server MCP di mcp.json — dirujuk lewat envFrom/headersFrom,
# tidak pernah ditulis di dalam mcp.json itu sendiri.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
FIRECRAWL_API_KEY=

# Tool scraping first-party (web_scrape).
SCRAPE_MAX_BYTES=2000000
SCRAPE_TIMEOUT_MS=15000
# JANGAN diaktifkan di production — ini membuka pintu SSRF ke jaringan internal.
SCRAPE_ALLOW_PRIVATE_HOSTS=false
