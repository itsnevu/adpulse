# ===== App =====
NODE_ENV=development
PORT=4000
# Host bind HTTP server. Default: production=127.0.0.1 (di belakang nginx —
# jangan ekspos :4000 langsung), selain itu 0.0.0.0. Isi hanya bila perlu
# override (mis. container production butuh 0.0.0.0).
BIND_HOST=
APP_URL=http://localhost:3000
# WAJIB diganti string acak >= 32 char — generate: openssl rand -hex 32.
# NODE_ENV=production MENOLAK boot dengan nilai placeholder/default/pendek.
JWT_SECRET=ganti-dengan-string-acak-panjang
DATABASE_URL=postgres://adpulse:adpulse@localhost:5432/adpulse

# ===== AI (Claude) =====
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# ===== Mock mode (true = pakai data sample, tanpa API key ads asli) =====
MOCK_ADS=true

# ===== Google Ads =====
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ===== Meta Ads =====
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ===== LinkedIn Ads (phase 2) =====
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ===== Email =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=insights@adpulse.local

# ===== Scheduler (cron) =====
SYNC_CRON=0 */4 * * *
INSIGHT_EMAIL_CRON=0 12 * * *
# true = matikan semua cron (sync & email) — berguna saat dev/debug
DISABLE_CRON=false

# ===== Security & Hardening (v1.1) =====
JWT_ACCESS_TTL=1h
REFRESH_TOKEN_TTL_DAYS=30
# WAJIB di production — 64 hex char, generate: openssl rand -hex 32 (AES-256-GCM utk token ads di DB)
TOKEN_ENCRYPTION_KEY=
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=300
LOG_LEVEL=info
SENTRY_DSN=
DATABASE_URL_TEST=postgres://adpulse:adpulse@localhost:5432/adpulse_test
